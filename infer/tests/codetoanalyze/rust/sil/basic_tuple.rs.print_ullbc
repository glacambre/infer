# Final ULLBC before serialization:

// Full name: basic_tuple::main
fn main()
{
    let _0: (); // return
    let x: (i32, i32); // local
    let one: i32; // local
    let two: i32; // local
    let _4: i32; // anonymous local
    let _5: i32; // anonymous local

    bb0: {
        storage_live(_0);
        _0 = ();
        storage_live(x);
        x = (const 1i32, const 2i32);
        storage_live(one);
        one = copy x.0;
        storage_live(two);
        two = copy x.1;
        storage_live(_4);
        _4 = copy two;
        x.0 = move _4;
        storage_dead(_4);
        storage_live(_5);
        _5 = copy one;
        x.1 = move _5;
        storage_dead(_5);
        _0 = ();
        storage_dead(two);
        storage_dead(one);
        storage_dead(x);
        return;
    }
}



