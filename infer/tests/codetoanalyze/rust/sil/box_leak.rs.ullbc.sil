type alloc::alloc::Global = {}

define box_leak::main() : void {
  local var_0: void, b_1: *int, var_2: void, var_3: *int
  #node_0:
      store &var_0 <- null:void
      n0 = __sil_boxnew(42)
      store &b_1 <- n0:*int
      jmp node_2
      .handlers node_1
      
  #node_1:
      throw "UnwindResume"
      
  #node_2:
      n1:*int = load &b_1
      store &var_3 <- n1:*int
      n2:*int = load &var_3
      n3 = __rust_retag(&var_3, n2, 1)
      n4:*int = load &var_3
      n5 = core::mem::forget(n4)
      store &var_2 <- n5:void
      jmp node_4
      .handlers node_3
      
  #node_3:
      throw "UnwindResume"
      
  #node_4:
      store &var_0 <- null:void
      n6:void = load &var_0
      ret n6
      
}

