# Final ULLBC before serialization:

// Full name: basic_if::main
fn main()
{
    let _0: (); // return
    let b: bool; // local
    let _2: bool; // anonymous local

    bb0: {
        storage_live(_0);
        _0 = ();
        storage_live(b);
        b = const true;
        storage_live(_2);
        _2 = copy b;
        if move _2 -> bb1 else -> bb2;
    }

    bb1: {
        b = const false;
        _0 = ();
        storage_dead(_2);
        storage_dead(b);
        return;
    }

    bb2: {
        b = const true;
        _0 = ();
        storage_dead(_2);
        storage_dead(b);
        return;
    }
}



